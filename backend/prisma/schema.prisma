generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  EMPLOYEE
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String
  role         Role          @default(EMPLOYEE)
  emailVerified Boolean       @default(false)
  accountStatus AccountStatus @default(PENDING)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]
  verificationTokens EmailVerificationToken[]

  @@index([role])
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Transaction {
  id                String            @id @default(cuid())
  transactionNumber String            @unique
  employeeId        String
  totalAmount       Decimal           @db.Decimal(12, 2)
  customerName      String?
  customerPhone     String?
  customerAddress   String?
  discount          Decimal           @default(0) @db.Decimal(12, 2)
  taxRate           Decimal           @default(0) @db.Decimal(5, 2)
  taxAmount         Decimal           @default(0) @db.Decimal(12, 2)
  isPaid            Boolean           @default(false)
  paymentMethod     String            @default("Cash")
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  employee          User              @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  items             TransactionItem[]

  @@index([employeeId])
  @@index([createdAt])
  @@index([transactionNumber])
}

model TransactionItem {
  id            String      @id @default(cuid())
  transactionId String
  itemName      String
  quantity      Decimal     @db.Decimal(12, 2)
  unitPrice     Decimal     @db.Decimal(12, 2)
  amount        Decimal     @db.Decimal(12, 2)
  productId     String?
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  product       Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([transactionId])
  @@index([itemName])
  @@index([productId])
}

model Product {
  id             String            @id @default(cuid())
  name           String
  code           String            @unique
  unitPrice      Decimal           @db.Decimal(12, 2)
  stockQuantity  Decimal           @default(0) @db.Decimal(12, 2)
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  transactionItems TransactionItem[]

  @@index([name])
  @@index([isActive])
}

model BusinessSettings {
  id                    String   @id @default("default")
  businessName          String   @default("BizManager Business")
  contactEmail          String?
  contactPhone          String?
  address               String?
  currency              String   @default("USD")
  showBusinessContact   Boolean  @default(true)
  showInvoiceLogo       Boolean  @default(false)
  showPaymentStatus     Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}
